# Books Service environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file (it is gitignored).

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=books_db

# HTTP server port for the Books microservice
PORT=3001
AUTHORS_SERVICE_URL=http://127.0.0.1:3002
CATEGORIES_SERVICE_URL=http://127.0.1.3003
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672