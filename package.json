{
  "name": "@vaibhav-sf/bms-node-backend",
  "version": "1.0.0",
  "description": "A RESTful backend API for managing books, built with **Node.js** and **Express.js**. The API provides endpoints to create, read, update, and delete book records.",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaibhav-sf/BMS-Node-Backend.git"
  },
  "author": "Vaibhav Sharma",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vaibhav-sf/BMS-Node-Backend/issues"
  },
  "homepage": "https://github.com/vaibhav-sf/BMS-Node-Backend#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.0"
  }
}
